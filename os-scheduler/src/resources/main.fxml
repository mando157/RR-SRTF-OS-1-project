package scheduler.sim;

import scheduler.sim.model.Process;
import scheduler.sim.model.Result;
import scheduler.sim.scheduler.RoundRobin;
import scheduler.sim.scheduler.SRTF;
import scheduler.sim.metrics.Metrics;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        
        System.out.println("\n TEST CASE 1: Basic Processes");
        System.out.println("=================================");
        
        List<Process> processes1 = Arrays.asList(
            new Process("P1", 0, 8),
            new Process("P2", 1, 4),
            new Process("P3", 2, 9),
            new Process("P4", 3, 5)
        );
        
        runTest(processes1, "Basic Test");
        
        System.out.println("\n\n TEST CASE 2: All Processes Arrive at Time 0");
        System.out.println("===============================================");
        
        List<Process> processes2 = Arrays.asList(
            new Process("P1", 0, 6),
            new Process("P2", 0, 3),
            new Process("P3", 0, 8),
            new Process("P4", 0, 4)
        );
        
        runTest(processes2, "Same Arrival Time");
        
        System.out.println("\n\n TEST CASE 3: Different Arrival Times");
        System.out.println("========================================");
        
        List<Process> processes3 = Arrays.asList(
            new Process("P1", 0, 5),
            new Process("P2", 2, 2),
            new Process("P3", 3, 1),
            new Process("P4", 5, 3)
        );
        
        runTest(processes3, "Staggered Arrival");
    }
    
    private static void runTest(List<Process> processes, String testName) {
        System.out.println("\n Process Details:");
        System.out.println("+----------+--------------+------------+");
        System.out.println("| Process  | Arrival Time | Burst Time |");
        System.out.println("+----------+--------------+------------+");
        for (Process p : processes) {
            System.out.printf("|    %-4s  |      %2d      |     %2d     |\n", 
                p.getId(), p.getArrivalTime(), p.getBurstTime());
        }
        System.out.println("+----------+--------------+------------+");
        
        List<Process> processesForRR = copyProcesses(processes);
        List<Process> processesForSRTF = copyProcesses(processes);
        
        RoundRobin rr = new RoundRobin(3);
        Result rrResult = rr.schedule(processesForRR);
        System.out.print(Metrics.getResultsString(" Round Robin (Q=3)", rrResult));
        System.out.print(Metrics.getGanttChartString("Round Robin (Q=3)", rrResult));
        
        SRTF srtf = new SRTF();
        Result srtfResult = srtf.schedule(processesForSRTF);
        System.out.print(Metrics.getResultsString(" SRTF", srtfResult));
        System.out.print(Metrics.getGanttChartString("SRTF", srtfResult));
        
        System.out.print(Metrics.getComparisonString(rrResult, srtfResult, "RR", "SRTF"));
    }
    
    private static List<Process> copyProcesses(List<Process> original) {
        List<Process> copy = new ArrayList<>();
        for (Process p : original) {
            copy.add(new Process(p));
        }
        return copy;
    }
}
