<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import scheduler.sim.gui.GanttChart?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="scheduler.sim.gui.MainController"
            fitToWidth="true"
            style="-fx-background-color: #0f0f1a; -fx-background: #0f0f1a;">

    <VBox styleClass="main-container"
          spacing="16"
          style="-fx-background-color: #0f0f1a; -fx-padding: 20;">

        <!-- INPUT -->
        <HBox spacing="10">
            <TextField fx:id="pidField"     promptText="Process ID"   styleClass="text-field" prefWidth="130"/>
            <TextField fx:id="arrivalField" promptText="Arrival Time" styleClass="text-field" prefWidth="130"/>
            <TextField fx:id="burstField"   promptText="Burst Time"   styleClass="text-field" prefWidth="130"/>
            <Button fx:id="addBtn" text="＋ Add Process" styleClass="btn-secondary"/>
        </HBox>

        <!-- PROCESS LIST -->
        <Label text="Added Processes" styleClass="section-title"/>
        <HBox spacing="10">
            <TableView fx:id="processTable" prefHeight="150" prefWidth="500" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="procPid" text="PID" prefWidth="100"/>
                    <TableColumn fx:id="procAt"  text="Arrival Time" prefWidth="150"/>
                    <TableColumn fx:id="procBt"  text="Burst Time"   prefWidth="150"/>
                </columns>
            </TableView>
            <VBox spacing="10">
                <Button fx:id="deleteBtn" text="🗑 Delete Selected" styleClass="btn-secondary"/>
                <Button fx:id="clearBtn"  text="✖ Clear All"       styleClass="btn-secondary"/>
            </VBox>
        </HBox>

        <!-- QUANTUM + RUN -->
        <HBox spacing="10" style="-fx-alignment: center-left;">
            <TextField fx:id="quantumField" promptText="Quantum (RR)" styleClass="text-field" prefWidth="130"/>
            <Button fx:id="runBtn" text="▶ Run Simulation" styleClass="btn-primary"/>
            <Label fx:id="quantumLabel"
                   text=""
                   style="-fx-background-color: #312e81; -fx-text-fill: #a5b4fc;
                          -fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-padding: 6 14 6 14; -fx-background-radius: 8;"/>
        </HBox>

        <Separator/>

        <!-- GANTT -->
        <Label text="Round Robin — Gantt Chart" styleClass="section-title"/>
        <ScrollPane fitToHeight="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    prefHeight="80"
                    style="-fx-background-color: #1a1a2e; -fx-background: #1a1a2e; -fx-border-color: #2d2d4e; -fx-border-radius: 10;">
            <scheduler.sim.gui.GanttChart fx:id="rrChart"/>
        </ScrollPane>
        <Label text="Round Robin — Ready Queue" styleClass="section-title"/>
        <scheduler.sim.gui.ReadyQueueView fx:id="readyQueueView" prefHeight="200"/>

        <Label text="SRTF — Gantt Chart" styleClass="section-title"/>
        <ScrollPane fitToHeight="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    prefHeight="80"
                    style="-fx-background-color: #1a1a2e; -fx-background: #1a1a2e; -fx-border-color: #2d2d4e; -fx-border-radius: 10;">
            <scheduler.sim.gui.GanttChart fx:id="srtfChart"/>
        </ScrollPane>

        <Separator/>

        <!-- TABLES -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Round Robin Results" styleClass="section-title"/>
                <TableView fx:id="rrTable" prefWidth="420" prefHeight="160" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="rrPid"  text="PID" prefWidth="60"/>
                        <TableColumn fx:id="rrAt"   text="AT"  prefWidth="60"/>
                        <TableColumn fx:id="rrBt"   text="BT"  prefWidth="60"/>
                        <TableColumn fx:id="rrWt"   text="WT"  prefWidth="60"/>
                        <TableColumn fx:id="rrTat"  text="TAT" prefWidth="60"/>
                        <TableColumn fx:id="rrRt"   text="RT"  prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="SRTF Results" styleClass="section-title"/>
                <TableView fx:id="srtfTable" prefWidth="420" prefHeight="160" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="srtfPid"  text="PID" prefWidth="60"/>
                        <TableColumn fx:id="srtfAt"   text="AT"  prefWidth="60"/>
                        <TableColumn fx:id="srtfBt"   text="BT"  prefWidth="60"/>
                        <TableColumn fx:id="srtfWt"   text="WT"  prefWidth="60"/>
                        <TableColumn fx:id="srtfTat"  text="TAT" prefWidth="60"/>
                        <TableColumn fx:id="srtfRt"   text="RT"  prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <Separator/>

        <!-- COMPARISON -->
        <Label text="Comparison Summary" styleClass="section-title"/>
        <TableView fx:id="comparisonTable" prefHeight="130" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colMetric" text="Metric"  prefWidth="180"/>
                <TableColumn fx:id="colRR"     text="RR"      prefWidth="120"/>
                <TableColumn fx:id="colSRTF"   text="SRTF"    prefWidth="120"/>
                <TableColumn fx:id="colWinner" text="Winner"  prefWidth="120"/>
            </columns>
        </TableView>

        <Separator/>

         <!-- FAIRNESS vs EFFICIENCY -->
        <Label text="Fairness vs Efficiency Analysis" styleClass="section-title"/>
        <VBox spacing="8"
              style="-fx-background-color: #1a1a2e; -fx-padding: 16;
                     -fx-background-radius: 10; -fx-border-color: #2d2d4e; -fx-border-radius: 10;">
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2d1b69; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text=" Round Robin — Fairness"
                           style="-fx-text-fill: #a855f7; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Label fx:id="rrFairnessLabel"
                           text="—"
                           wrapText="true"
                           style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #064e3b; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text=" SRTF — Efficiency"
                           style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Label fx:id="srtfEfficiencyLabel"
                           text="—"
                           wrapText="true"
                           style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
            <Label fx:id="fairnessVerdictLabel"
                   text="Run a simulation to see the analysis."
                   wrapText="true"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-padding: 4 0 0 0;"/>
         </VBox>

        <Separator/>

        
        <!-- FINAL CONCLUSION -->
        <Label text="Final Conclusion" styleClass="section-title"/>
        <VBox spacing="10"
              style="-fx-background-color: #1a1a2e; -fx-padding: 16;
                     -fx-background-radius: 10; -fx-border-color: #2d2d4e; -fx-border-radius: 10;">
            <Label fx:id="conclusionLabel"
                   text="Run a simulation to see the conclusion."
                   wrapText="true"
                   style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
        </VBox>

    </VBox>
</ScrollPane>